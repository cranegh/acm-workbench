#include<iostream>
using namespace std;
int main(){
    int n,m,hn,hm,f[23][23]={0};
    cin>>n>>m>>hn>>hm;
    int d[9][2]={{0,0},{2,1},{1,2},{-1,2},{-2,1},{-2,-1},{-1,-2},{1,-2},{2,-1}};
    int ctrl[23][23]={0};
    for (int i=0 ; i<n ; i++){
        ctrl[hn+d[i][0]][hm+d[i][1]]=1;
    }
    f[0][0]=1-ctrl[0][0];
    for (int i=0 ; i<n ; i++){
        for (int j=0 ; j<m ; j++){
            if(ctrl[i][j]) continue;
            if(i!=0) f[i][j]+=f[i-1][j];
            if(j!=0) f[i][j]+=f[i][j-1];
        }
    }
    cout<<f[n][m];
    return 0;
}